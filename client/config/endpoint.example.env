# 接続先の MCP サーバ。`make config` で endpoint.env にコピーして使う（endpoint.env は git 管理外）。

# claude mcp add に付ける名前。ツールは mcp__<この名前>__<ツール名> として見える。
MCP_SERVER_NAME=ops-mcp

# サーバの Streamable HTTP エンドポイント（末尾の /mcp が必須）。
# 同一ホスト内: http://127.0.0.1:8848/mcp
# 別マシン:     http://<サーバのIP>:8848/mcp   （サーバ側の準備は docs/02-remote-host.md）
MCP_SERVER_URL=http://127.0.0.1:8848/mcp

# 登録の scope。
#   local   : 「このディレクトリ(プロジェクト)で claude を起動したとき」だけ有効。自分専用（既定）
#   project : リポジトリの .mcp.json に書く。チーム共有。初回に信頼確認が出る
#   user    : どのディレクトリで起動しても有効。自分専用
MCP_SCOPE=local
