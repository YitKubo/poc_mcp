# server/scripts/run_server.sh が読み込む設定。
# `cp server.env.example server.env` して使う（server.env は git 管理外）。

# 待受アドレス。既定は 127.0.0.1（同一ホスト内のみ）。
# 別マシンから繋ぐ場合のみ 0.0.0.0 にし、MCP_ALLOWED_HOSTS も設定すること。
MCP_HOST=127.0.0.1
MCP_PORT=8848

# MCP_HOST が localhost 以外のときに許可する Host ヘッダ（カンマ区切り）。
# 例: MCP_ALLOWED_HOSTS=192.168.1.10:*,myhost.local:*
# 未設定のまま 0.0.0.0 にすると全リクエストが 421 Misdirected Request になる。
MCP_ALLOWED_HOSTS=

# ログレベル (DEBUG / INFO / WARNING)
MCP_LOG_LEVEL=INFO

# TTL キャッシュの倍率（既定 1.0 = resource_usage 等 2秒 / system_overview 等 10秒 / ログ 3秒）。
# 0 でキャッシュ無効（single-flight＝実行中の重複排除は残る）。
# MCP_CACHE_TTL_SCALE=1.0
